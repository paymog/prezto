# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ "$SHLVL" -eq 1 && ! -o LOGIN && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

export PATH="$PATH:$HOME/.foundry/bin"

# Point non-interactive bash (coding agents spawned by the Paseo daemon inherit
# this env) at a loader that reproduces the interactive per-directory env hooks
# (direnv + sinatra secrets). Interactive zsh is unaffected — it uses ~/.zshrc.
export BASH_ENV="$HOME/.agent-shell-env.sh"
