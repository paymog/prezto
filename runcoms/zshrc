# omp memory routing: default = personal local Hindsight (http://127.0.0.1:8888).
# Under ~/code/goldskyio, inject goldsky-hindsight.yml → prod Hindsight + token.
omp() {
  local overlay="$HOME/.omp/goldsky-hindsight.yml"
  # --config is a root-only flag; subcommands (update, commit, config, ...)
  # reject it. Only inject the overlay for interactive/agent runs, i.e. when
  # the first arg is not a management subcommand.
  case "$1" in
    acp|agents|auth-broker|auth-gateway|bench|commit|completions|config|dry-balance|gallery|gc|grep|grievances|install|join|models|plugin|read|say|search|setup|shell|ssh|stats|tiny-models|token|ttsr|update|usage|worktree)
      command omp "$@"
      ;;
    *)
      if [[ -f "$overlay" && "$PWD/" == "$HOME/code/goldskyio/"* ]]; then
        command omp --config "$overlay" "$@"
      else
        command omp "$@"
      fi
      ;;
  esac
}

