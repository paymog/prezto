if typeset -f nvm_find_nvmrc >/dev/null; then
  autoload -U add-zsh-hook

load-nvmrc() {
  if [[ -n $_nvm_async_pwd ]]; then
    _nvm_async_pwd=''
    nvm use --silent default >/dev/null
  fi
  local nvmrc_path
  nvmrc_path="$(nvm_find_nvmrc)"

    if [ -n "$nvmrc_path" ]; then
      local nvmrc_node_version
      nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

      if [ "$nvmrc_node_version" = "N/A" ]; then
        nvm install
      elif [ "$nvmrc_node_version" != "$(nvm version)" ]; then
        nvm use
      fi
    elif [ -n "$(PWD=$OLDPWD nvm_find_nvmrc)" ] && [ "$(nvm version)" != "$(nvm version default)" ]; then
      echo "Reverting to nvm default version"
      nvm use default
    fi
  }

add-zsh-hook chpwd load-nvmrc
if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]]; then
  load-nvmrc
fi
if [[ -s "$NVM_DIR/nvm.sh" && -t 0 && -t 1 && $TERM != dumb ]]; then
  _nvm_async_pwd=$PWD
  _nvm_async_bin=$NVM_BIN
  _nvm_async_init() {
    if [[ -n "$NVM_BIN" && -x "$NVM_BIN/node" && $commands[node] == "$NVM_BIN/node" ]]; then
      nvm use --silent "$(nvm current)" >/dev/null || return
    else
      nvm use --silent default >/dev/null || :
    fi
    _nvm_async_pwd=''
    load-nvmrc
    [[ -n "$NVM_BIN" && -x "$NVM_BIN/node" ]] || return 1
    print -r -- "$PWD"$'\n'"$NVM_BIN"$'\n'"$NVM_INC"
  }
  _nvm_async_ready() {
    async_unregister_callback nvm_startup
    async_stop_worker nvm_startup
    local -a result
    result=("${(@f)3}")
    # Ignore stale results after a directory change or a manual Node switch.
    if (( $2 == 0 && $#result == 3 )) && [[ $result[1] == $_nvm_async_pwd && $NVM_BIN == $_nvm_async_bin ]]; then
      local version_dir=${result[2]:h}
      export PATH="$(nvm_change_path "$PATH" /bin "$version_dir")"
      if (( $+commands[manpath] )); then
        export MANPATH="$(nvm_change_path "${MANPATH:-$(manpath)}" /share/man "$version_dir")"
      fi
      export NVM_BIN=$result[2] NVM_INC=$result[3]
      rehash
    fi
    _nvm_async_pwd=''
  }
  async_start_worker nvm_startup -n
  async_register_callback nvm_startup _nvm_async_ready
  async_job nvm_startup _nvm_async_init
fi
fi


