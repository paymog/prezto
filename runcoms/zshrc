# ~/.secrets.sinatra loads in ANY path containing "sinatra" (checkouts, worktrees,
# conductor workspaces, ...). direnv owns goldsky/other .envrc trees; when a direnv
# env is active we defer to it. direnv prepends its own chpwd hook, so DIRENV_DIR is
# already current by the time this runs — making the two managers race-free.
_sinatra_secrets() {
  [[ -n "$DIRENV_DIR" ]] && return          # direnv (e.g. goldsky) owns the env here
  local f="$HOME/.secrets.sinatra"
  [[ -f "$f" ]] || return
  if [[ "$PWD" == *sinatra* ]]; then
    source "$f"
  else
    local -a vars
    vars=(${(f)"$(sed -nE 's/^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$f")"})
    (( ${#vars} )) && unset ${vars}          # unload sinatra vars when leaving
  fi
}

